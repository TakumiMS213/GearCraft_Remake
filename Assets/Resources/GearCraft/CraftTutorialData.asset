    body: "\u3053\u3053\u3067\u306F\u88C5\u5099\u3084\u30E2\u30B8\u30E5\u30FC\u30EB\u3092\u300C\u30AF\u30E9\u30D5\u30C8\u300D\u3057\u307E\u3059\u3002"
