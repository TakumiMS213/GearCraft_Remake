  - title: Result
    body: "\u4E2D\u592E\u306B\u4F5C\u6210\u7D50\u679C\u304C\u8868\u793A\u3055\u308C\u307E\u3059\u3002"
    targetName: Result_ScrapModule
    waitCondition: 0
  - title: Materials
    body: "\u5FC5\u8981\u7D20\u6750\u306F\u4E0B\u306B\u8868\u793A\u3055\u308C\u307E\u3059\u3002"
    targetName: Material_Scrap|Material_Gear
    waitCondition: 0
  - title: Goal
    body: "\u8A66\u3057\u306B\u3001\u300CScrapModule\u300D\u3092\u4F5C\u6210\u3057\u3066\u307F\u307E\u3057\u3087\u3046\u3002"
    targetName: Result_ScrapModule
    waitCondition: 0
  - title: ScrapModule
    body: "\u300CScrapModule\u300D\u306F\u7D20\u6750\u56DE\u53CE\u3092\u88DC\u52A9\u3059\u308B\u30E2\u30B8\u30E5\u30FC\u30EB\u3067\u3059\u3002"
    targetName: Result_ScrapModule
    waitCondition: 0
  - title: Supplies
    body: "\u5FC5\u8981\u7D20\u6750\u306F\u7279\u5225\u306B\u914D\u5E03\u6E08\u307F\u3067\u3059\u3002"
