MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0b1e34a6c84834a3fa61178372eb0507, type: 3}
  m_Name: DormFurnitureTutorial
  m_EditorClassIdentifier: 
  pages:
  - portrait: {fileID: 21300000, guid: b80efaa4c3b416e4798415a5c4a51759, type: 3}
    text: "門修復\n門の耐久力を50増やせます。\n門修復・食事・治療は、一晩にどれか1つです。"
    autoAdvanceSeconds: 8
    moveCamera: 1
    cameraPosition: {x: 0, y: 0, z: -10}
    cameraOrthographicSize: 4.8
    cameraMoveDuration: 1.2
  - portrait: {fileID: 21300000, guid: b80efaa4c3b416e4798415a5c4a51759, type: 3}
    text: "食事\n近接攻撃力か遠距離攻撃力が3上がります。\n家具の前で Space を押すと利用できます。"
    autoAdvanceSeconds: 8
    moveCamera: 1
    cameraPosition: {x: 0, y: 0, z: -10}
    cameraOrthographicSize: 4.8
    cameraMoveDuration: 1.2
  - portrait: {fileID: 21300000, guid: b80efaa4c3b416e4798415a5c4a51759, type: 3}
    text: "治療\n体力を100まで回復できます。\n体力が満タンの時は利用できません。"
    autoAdvanceSeconds: 8
    moveCamera: 1
    cameraPosition: {x: 0, y: 0, z: -10}
    cameraOrthographicSize: 4.8
    cameraMoveDuration: 1.2
  - portrait: {fileID: 21300000, guid: b80efaa4c3b416e4798415a5c4a51759, type: 3}
    text: "クラフト\n集めた素材で武器を作り、強化パーツを配置できます。\n家具の前で Space を押すと工房へ移動します。"
    autoAdvanceSeconds: 8
    moveCamera: 1
    cameraPosition: {x: 0, y: 0, z: -10}
    cameraOrthographicSize: 4.8
    cameraMoveDuration: 1.2
